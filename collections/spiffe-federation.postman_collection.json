              "body": "{\n  \"keys\": [\n    {\n      \"kty\": \"RSA\",\n      \"use\": \"x509-svid\",\n      \"kid\": \"string\",\n      \"crv\": \"P-521\",\n      \"x\": \"string\",\n      \"y\": \"string\",\n      \"n\": \"string\",\n      \"e\": \"string\",\n      \"x5c\": [\n        \"string\",\n        \"string\"\n      ]\n    },\n    {\n      \"kty\": \"RSA\",\n      \"use\": \"x509-svid\",\n      \"kid\": \"string\",\n      \"crv\": \"P-521\",\n      \"x\": \"string\",\n      \"y\": \"string\",\n      \"n\": \"string\",\n      \"e\": \"string\",\n      \"x5c\": [\n        \"string\",\n        \"string\"\n      ]\n    }\n  ],\n  \"spiffe_refresh_hint\": 2167,\n  \"spiffe_sequence\": 7932\n}",
