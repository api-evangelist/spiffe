                      "type": "any",
                      "value": "{{trust-domain}}",
                      "key": "trust-domain"
                    }
                  ]
                },
                "header": [
                  {
                    "disabled": false,
                    "description": "Requested response format. The bundle endpoint must return application/json. Clients may include this header to indicate they accept JSON responses.",
                    "key": "Accept",
