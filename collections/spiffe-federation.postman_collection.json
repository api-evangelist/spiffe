      "id": "0267c769-49de-4694-a13e-232ef4da069f",
      "name": "Bundle",
      "description": {
        "content": "SPIFFE trust bundle retrieval operations for fetching root CA certificates used to validate SVIDs issued by a trust domain",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "97cd8a14-e595-4487-8a59-2dea821053ea",
          "name": "SPIFFE Get trust bundle",
          "request": {
            "name": "SPIFFE Get trust bundle",
            "description": {
              "content": "Returns the current trust bundle for this SPIFFE trust domain as a JWKS (JSON Web Key Set) document. The trust bundle contains the root CA certificates that are used to validate X.509-SVIDs and JWT-SVIDs issued by this trust domain. Foreign SPIFFE implementations poll this endpoint to stay synchronized with trust bundle updates, enabling cross-domain workload authentication. The response is a standard JWKS document where each key entry represents a root CA certificate encoded as an X.509 certificate in the x5c claim.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "spiffe",
                "v1",
                "bundle"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "description": "The DNS name of the trust domain serving the bundle endpoint. The trust domain name is used as the server hostname.",
                  "type": "any",
                  "value": "{{trust-domain}}",
                  "key": "trust-domain"
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
          },
          "response": [
            {
              "id": "2f278ef7-2614-4d5a-9d0a-9507e3cac18e",
              "name": "Trust bundle retrieved successfully",
              "originalRequest": {
